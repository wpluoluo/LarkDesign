/**
 * FrameView - 帧视图（画板显示）
 *
 * 对应原型 src/components/FrameView.vue + useFrameHandles.ts
 * 在 CanvasStage 中渲染单个 Frame 及其子对象
 */
import { ColorToken } from '../tokens/DesignTokens'
import { FontWeightConstant, FontSizeToken } from '../tokens/DesignTokens'
import { IconCharToken as Icon } from '../tokens/IconToken'
import { Frame, SceneObject, Layer } from '../types/SceneTypes'

@Component
export struct FrameView {
  @Prop frame: Frame = { id: '', type: 'single', name: '', x: 0, y: 0, width: 0, height: 0, children: [] }
  @Prop zoom: number = 100
  @Prop isSelected: boolean = false
  onSelect: () => void = () => {}
  onMove: (x: number, y: number) => void = () => {}

  build(): void {
    Stack() {
      // Frame 背景
      Column()
        .width(`${this.frame.width}px`)
        .height(`${this.frame.height}px`)
        .backgroundColor(this.frame.background ?? '#FFFFFF')
        .border({
          width: 1,
          color: this.isSelected ? ColorToken.primary : ColorToken.border
        })
        .borderRadius(1)
        .shadow({ radius: 2, color: '#00000012', offsetX: 0, offsetY: 1 })

      // Frame 名称标签
      Row() {
        Text(this.frame.name)
          .fontSize(9)
          .fontWeight(FontWeightConstant.medium)
          .fontColor(ColorToken.muted)
          .maxLines(1)
          .textOverflow(TextOverflow.Ellipsis)
      }
      .width(`${this.frame.width}px`)
      .padding({ left: 4, right: 4 })
      .position({ x: 0, y: -18 })
    }
    .width(`${this.frame.width}px`)
    .height(`${this.frame.height}px`)
    .position({
      x: `${this.frame.x}px`,
      y: `${this.frame.y}px`
    })
    .onClick(() => {
      this.onSelect()
    })
  }
}
